# Variables du FRONT-END (Vite) — optionnelles.
# Par défaut, l'interface appelle « /api » (proxy Vite en développement, ou même domaine quand Laravel la sert).

# URL complète de l'API si elle est hébergée ailleurs (ex. interface sur GitHub Pages, API sur un serveur) :
# VITE_API_URL=https://api.monmagasin.com/api

# Chemin de base de l'interface (GitHub Pages : /MARAKAFA/). Laisser vide pour la racine « / ».
# VITE_BASE=/MARAKAFA/
